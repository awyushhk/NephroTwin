# Repo-wide; each module has its own .gitignore for its data and checkpoints
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.env
api/.env
api/.env.*
!api/.env.example

# Local datasets and cohort exports
data/raw/
data/processed/mimic_renal_cohort/
data/processed/mimic_renal_omr_bp/
data/processed/mimic_renal_cohort.previous-*/

# Local environments, database backups, and exports must stay out of commits
**/.venv/
*.dump
data/backups/

# Temporary pipeline and test artifacts
data/processed/mimic_renal_cohort.tmp-*/
data/processed/mimic_renal_cohort.hba1c-stage-*/
data/processed/stage_check_codex/
.mimic_renal_cohort.hba1c-stage-*/
mimic_renal_cohort.hba1c-stage-*/
.pytest-tmp-mimic/
tests/.pytest-temp/
tests/pytest-omr-temp/
data/processed/.mimic_renal_omr_bp.stage-*/

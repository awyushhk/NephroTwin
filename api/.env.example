# Local PostgreSQL URL. Create the database before running migrations.
DATABASE_URL=postgresql+psycopg://renal_app:change-me@localhost:5432/renal_twin
ENVIRONMENT=development

# Renal observability windows and descriptive-trend sufficiency thresholds
RENAL_OBSERVABILITY_RECENT_DAYS=30
RENAL_OBSERVABILITY_HISTORICAL_DAYS=365
RENAL_OBSERVABILITY_STALE_DAYS=90
RENAL_TREND_MIN_OBSERVATIONS=3
RENAL_TREND_MIN_SPAN_DAYS=30
